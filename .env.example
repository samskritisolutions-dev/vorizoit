# Payload CMS Secret (any long random string)
PAYLOAD_SECRET=your_secret_key_here

# Database URI
# Option A: Local SQLite (default for offline local development)
# DATABASE_URI=file:./vorizo.db

# Option B: Supabase PostgreSQL (for Vercel production & cloud development)
# Get from Supabase Project Settings -> Database -> Connection string (URI)
# Use the pooled connection (port 6543) for Vercel Serverless:
# DATABASE_URI=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
